# Flask session signing key. Use a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Local dev defaults
TRAEFIK_HOST=skydive-theorie.localhost
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
APP_PORT=5000

# Public DNS name that points to this server for production.
# TRAEFIK_HOST=theorie.example.com

# Email address used by Let's Encrypt for certificate notifications.
ACME_EMAIL=admin@example.com

# KNMI credentials are server-side only. Rotate any key shared publicly.
KNMI_API_KEY=
KNMI_OPEN_DATA_URL=https://api.dataplatform.knmi.nl/open-data