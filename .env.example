# Public DNS name that points to this server.
TRAEFIK_HOST=theorie.example.com

# Email address used by Let's Encrypt for certificate notifications.
ACME_EMAIL=admin@example.com

# Leave empty for local development. Set to letsencrypt for a public domain.
TRAEFIK_CERT_RESOLVER=letsencrypt

# Keep these at 80 and 443 on a public server.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443